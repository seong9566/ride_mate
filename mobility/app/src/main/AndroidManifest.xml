<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 백엔드 API 통신 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Pleos Vehicle SDK: 문 열림 상태 조회·리스너 (App Market 사전 승인 필요) -->
    <uses-permission android:name="pleos.car.permission.CAR_DOORS" />
    <!-- Pleos Vehicle SDK: 기어(P단) 확인 — 정차 중에만 경로 시작 허용 (App Market 사전 승인 필요) -->
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />
    <!-- Pleos NaviHelper SDK: 목적지·경유지 전달(NAVI_ROUTE_SEARCH), 경로/트립 정보 조회(NAVI_ROUTE) -->
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE_SEARCH" />
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE" />
    <!-- Pleos FusedLocation SDK: 차량 위치 (dangerous → 런타임 요청) -->
    <uses-permission android:name="pleos.car.permission.FUSED_LOCATION" />
    <!-- V01 시동 알림: 알림 표시(Android 13+ 런타임 요청), 부팅(시동) 수신 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".WayMeApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PickUp_Hyundai">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:label="@string/title_activity_main"
            android:theme="@style/Theme.PickUp_Hyundai"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Gleo Interface: START_PICKUP(component=activity) — "글레오, 오늘 픽업 시작해 줘" -->
            <intent-filter>
                <action android:name="START_PICKUP" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="distractionOptimized"
                android:value="true" />
        </activity>

        <!-- V01: 시동(부팅) 시 오늘의 픽업 알림 -->
        <receiver
            android:name=".notify.IgnitionReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
        <!-- Gleo Interface: service 함수(조회·외부 요청)를 Gleo가 브로드캐스트로 호출 -->
        <receiver
            android:name=".platform.gleo.GleoActionReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="GET_PICKUP_STATUS" />
                <action android:name="SEND_PICKUP_MESSAGE" />
            </intent-filter>
        </receiver>
        <!-- 알림 "닫기" 버튼 -->
        <receiver
            android:name=".notify.NotificationActionReceiver"
            android:exported="false" />
    </application>

</manifest>