    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const now = $now.setZone('Asia/Seoul');\nconst runDt = now.minus({ minutes: now.minute % 5 }).set({ second: 0, millisecond: 0 });\nconst hasKey = String($env.TOPIS_API_KEY ?? '').trim().length > 0;\n\nreturn [{\n  json: {\n    runDt: runDt.toFormat('yyyy-LL-dd HH:mm:ss'),\n    hasKey: hasKey ? 1 : 0,\n  },\n}];"
      },
      "id": "calculate-run-time",
      "name": "회차 시각 계산",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1280,
        260
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO TRAFFIC_COLLECT_RUN (SOURCE, RUN_DT, STATUS, LINK_COUNT, SAVED_COUNT, ERROR_MESSAGE, CREATE_DT, CREATE_USER, UPDATE_DT, UPDATE_USER)\nVALUES ('TOPIS', $1, 'FAILED', 0, 0, NULL, NOW(), 'SYSTEM', NOW(), 'SYSTEM')\nON DUPLICATE KEY UPDATE UPDATE_DT = NOW(), UPDATE_USER = 'SYSTEM'",
        "options": {
          "queryReplacement": "={{ [$json.runDt] }}"
        }
      },
