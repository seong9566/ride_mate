        "query": "SELECT COLLECT_RUN_ID, RUN_DT, $1 AS HAS_KEY\nFROM TRAFFIC_COLLECT_RUN\nWHERE SOURCE = 'TOPIS' AND RUN_DT = $2",
        "options": {
          "queryReplacement": "={{ [$('회차 시각 계산').first().json.hasKey, $('회차 시각 계산').first().json.runDt] }}"
