    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE TRAFFIC_COLLECT_RUN\nSET STATUS = 'NO_KEY', LINK_COUNT = 0, SAVED_COUNT = 0, ERROR_MESSAGE = NULL, UPDATE_DT = NOW(), UPDATE_USER = 'SYSTEM'\nWHERE COLLECT_RUN_ID = $1",
        "options": {
          "queryReplacement": "={{ [$json.COLLECT_RUN_ID] }}"
        }
      },
      "id": "mark-no-key",
      "name": "키 없음 기록",
      "type": "n8n-nodes-base.mySql",
      "typeVersion": 2.5,
      "position": [
        -320,
        480
      ],
