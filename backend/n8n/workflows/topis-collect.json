    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT TRAFFIC_LINK_ID, LINK_ID\nFROM TRAFFIC_LINK\nWHERE SOURCE = 'TOPIS' AND DELETE_YN = 0\nORDER BY TRAFFIC_LINK_ID",
        "options": {}
      },
      "id": "select-links",
      "name": "TOPIS 링크 조회",
      "type": "n8n-nodes-base.mySql",
      "typeVersion": 2.5,
      "position": [
        -320,
        160
      ],
      "credentials": {
        "mySql": {
          "id": "rmMysqlCred00001",
          "name": "ridemate-mysql"
        }
      },
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const links = $input.all()\n  .map((item) => item.json)\n  .filter((row) => row.TRAFFIC_LINK_ID != null && row.LINK_ID != null)\n  .map((row) => ({\n    trafficLinkId: Number(row.TRAFFIC_LINK_ID),\n    linkId: String(row.LINK_ID),\n  }));\nconst collectRunId = Number($('회차 행 조회').first().json.COLLECT_RUN_ID);\n\nreturn [{\n  json: {\n    collectRunId,\n    runDt: $('회차 시각 계산').first().json.runDt,\n    hasLinks: links.length > 0,\n    linkCount: links.length,\n    links,\n    errorMessage: '링크 목록 비어 있음 — 링크 목록 만들기를 먼저 실행',\n  },\n}];"
      },
      "id": "prepare-links",
      "name": "링크 목록 준비",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -80,
        160
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 3
          },
          "conditions": [
            {
              "id": "has-topis-links",
              "leftValue": "={{ $json.hasLinks }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "check-links",
      "name": "링크 목록 확인",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.4,
      "position": [
        160,
        160
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE TRAFFIC_COLLECT_RUN\nSET STATUS = 'FAILED', LINK_COUNT = 0, SAVED_COUNT = 0, ERROR_MESSAGE = $1, UPDATE_DT = NOW(), UPDATE_USER = 'SYSTEM'\nWHERE COLLECT_RUN_ID = $2",
        "options": {
          "queryReplacement": "={{ [$json.errorMessage, $json.collectRunId] }}"
        }
      },
      "id": "mark-empty-links",
      "name": "빈 링크 목록 기록",
      "type": "n8n-nodes-base.mySql",
      "typeVersion": 2.5,
      "position": [
        400,
        360
      ],
      "credentials": {
        "mySql": {
          "id": "rmMysqlCred00001",
          "name": "ridemate-mysql"
        }
      },
