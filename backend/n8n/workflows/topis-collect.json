    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const context = $input.first().json;\n\nreturn context.links.map((link) => ({\n  json: {\n    trafficLinkId: link.trafficLinkId,\n    linkId: link.linkId,\n  },\n}));"
      },
      "id": "expand-links",
      "name": "링크별 호출 행 만들기",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        400,
        80
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ 'http://openapi.seoul.go.kr:8088/' + $env.TOPIS_API_KEY + '/xml/TrafficInfo/1/1/' + $json.linkId }}",
        "authentication": "none",
        "options": {
          "batching": {
            "batch": {
              "batchSize": 1,
              "batchInterval": 250
            }
          },
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true,
              "responseFormat": "text",
              "outputPropertyName": "body"
            }
          },
          "timeout": 10000
        }
      },
      "id": "request-topis",
      "name": "TOPIS 소통 호출",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        640,
        160
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "mode": "combine",
        "combineBy": "combineByPosition",
        "options": {}
      },
      "id": "merge-response",
      "name": "호출 정보 합치기",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3.2,
      "position": [
        880,
        80
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "const status = Number($json.statusCode);\nconst body = typeof $json.body === 'string' ? $json.body : '';\n\nfunction tagValue(tagName) {\n  const pattern = new RegExp(`<${tagName}(?:\\\\s[^>]*)?>([\\\\s\\\\S]*?)<\\\\/${tagName}>`, 'i');\n  const match = body.match(pattern);\n  if (!match) return null;\n  return match[1]\n    .replace(/^\\s*<!\\[CDATA\\[/, '')\n    .replace(/\\]\\]>\\s*$/, '')\n    .trim();\n}\n\n// TOPIS 속도는 소수로 온다(예: 77.4). 0 이상 숫자를 받아 정수로 반올림한다.\nfunction nonNegativeRounded(value) {\n  if (value == null || !/^\\d+(\\.\\d+)?$/.test(value)) return null;\n  const parsed = Math.round(Number(value));\n  return Number.isSafeInteger(parsed) && parsed >= 0 ? parsed : null;\n}\n\nconst code = tagValue('CODE');\nconst safeCode = code && /^[A-Z0-9_-]{1,50}$/.test(code) ? code : null;\nconst roundedSpeed = nonNegativeRounded(tagValue('prcs_spd'));\n// 0~300km/h 밖은 비정상 값으로 본다(SPEED_KMH는 SMALLINT).\nconst speed = roundedSpeed !== null && roundedSpeed <= 300 ? roundedSpeed : null;\nconst travelSec = nonNegativeRounded(tagValue('prcs_trv_time'));\nconst ok = status === 200 && code === 'INFO-000' && speed !== null && travelSec !== null;\nlet reason = null;\n\nif (!ok) {\n  if (status !== 200) {\n    reason = Number.isInteger(status) ? `HTTP_${status}` : 'HTTP_ERROR';\n  } else if (code !== 'INFO-000') {\n    reason = safeCode || (code ? 'RESULT_CODE_INVALID' : 'RESULT_CODE_MISSING');\n  } else {\n    reason = 'INVALID_DATA';\n  }\n}\n\nreturn {\n  json: {\n    trafficLinkId: Number($json.trafficLinkId),\n    ok,\n    speed: ok ? speed : null,\n    travelSec: ok ? travelSec : null,\n    reason,\n  },\n};"
      },
      "id": "judge-response",
      "name": "응답 판정",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        80
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO TRAFFIC_SPEED (TRAFFIC_LINK_ID, COLLECT_RUN_ID, COLLECTED_DT, SOURCE_COLLECTED_DT, SPEED_KMH, TRAVEL_SEC, CREATE_DT, CREATE_USER, UPDATE_DT, UPDATE_USER)\nSELECT $1, $2, $3, NULL, $4, $5, NOW(), 'SYSTEM', NOW(), 'SYSTEM'\nWHERE $6 = 1\nON DUPLICATE KEY UPDATE TRAFFIC_SPEED_ID = TRAFFIC_SPEED_ID",
        "options": {
          "queryReplacement": "={{ [$json.trafficLinkId, $('링크 목록 준비').first().json.collectRunId, $('링크 목록 준비').first().json.runDt, $json.speed ?? 0, $json.travelSec ?? 0, $json.ok ? 1 : 0] }}"
        }
      },
      "id": "insert-speed",
      "name": "정상 소통 저장",
      "type": "n8n-nodes-base.mySql",
      "typeVersion": 2.5,
      "position": [
        1360,
        80
      ],
      "credentials": {
        "mySql": {
          "id": "rmMysqlCred00001",
          "name": "ridemate-mysql"
        }
      },
      "alwaysOutputData": true,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const results = $('응답 판정').all().map((item) => item.json);\nconst reasonCounts = {};\n\nfor (const result of results) {\n  if (result.ok) continue;\n  const reason = result.reason || 'UNKNOWN';\n  reasonCounts[reason] = (reasonCounts[reason] || 0) + 1;\n}\n\nconst dbFailed = $input.all().some((item) => item.json.error != null);\nif (dbFailed) reasonCounts.DB_INSERT_FAILED = (reasonCounts.DB_INSERT_FAILED || 0) + 1;\n\nconst errorSummary = Object.entries(reasonCounts)\n  .sort(([left], [right]) => left.localeCompare(right))\n  .map(([reason, count]) => `${reason}: ${count}`)\n  .join('; ')\n  .slice(0, 500);\n\nreturn [{\n  json: {\n    collectRunId: $('링크 목록 준비').first().json.collectRunId,\n    linkCount: $('링크 목록 준비').first().json.linkCount,\n    errorMessageParam: errorSummary || '__NULL__',\n  },\n}];"
      },
      "id": "summarize-results",
      "name": "실패 사유 집계",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1600,
        80
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT COUNT(*) AS SAVED_COUNT\nFROM TRAFFIC_SPEED\nWHERE COLLECT_RUN_ID = $1",
        "options": {
          "queryReplacement": "={{ [$json.collectRunId] }}"
        }
      },
      "id": "count-saved-rows",
      "name": "저장 행 수 조회",
      "type": "n8n-nodes-base.mySql",
      "typeVersion": 2.5,
      "position": [
        1840,
        80
      ],
      "credentials": {
        "mySql": {
          "id": "rmMysqlCred00001",
          "name": "ridemate-mysql"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE TRAFFIC_COLLECT_RUN\nSET LINK_COUNT = $1,\n    SAVED_COUNT = $2,\n    STATUS = CASE\n      WHEN SAVED_COUNT = LINK_COUNT THEN 'OK'\n      WHEN SAVED_COUNT = 0 THEN 'FAILED'\n      ELSE 'PARTIAL'\n    END,\n    ERROR_MESSAGE = NULLIF($3, '__NULL__'),\n    UPDATE_DT = NOW(),\n    UPDATE_USER = 'SYSTEM'\nWHERE COLLECT_RUN_ID = $4",
        "options": {
          "queryReplacement": "={{ [$('실패 사유 집계').first().json.linkCount, $json.SAVED_COUNT, $('실패 사유 집계').first().json.errorMessageParam, $('실패 사유 집계').first().json.collectRunId] }}"
        }
      },
