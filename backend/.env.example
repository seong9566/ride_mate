MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
# 3306을 다른 MySQL이 쓰고 있으면 빈 포트를 적는다(예: 3307). 비워 두면 3306이다.
MYSQL_PORT=

# 공공데이터포털(data.go.kr) 키다. 주차장 수집(n8n)과 실시간 빈자리 조회(API 서버)가 쓴다. 발급 화면의 원문을 넣는다.
DATA_GO_KR_API_KEY=

# 서울 TOPIS와 경기도 GITS 도로 소통 API 키다. 비워 두면 해당 소스를 호출하지 않는다.
TOPIS_API_KEY=
GITS_API_KEY=

# 아래는 docker compose --profile deploy로 API 서버를 띄울 때만 쓴다.
# 기존 DB 데이터를 이어 쓰면 Jwt·Crypto 값은 개발 때 쓰던 값과 같아야 한다(Crypto가 다르면 저장된 전화번호를 읽지 못한다).
# 새로 만들면 README "5. 로컬 설정"의 형식(base64 32바이트, 키마다 다른 값)을 따른다.
# MYSQL_PASSWORD에 `$`·`;`를 쓰지 않는다. compose 치환과 연결 문자열이 깨진다.
# 비워 두면 8080. 바꾸면 README 배포 절의 8080도 그 값으로 바꿔 쓴다
API_PORT=
JWT_ISSUER=
JWT_AUDIENCE=
JWT_SIGNING_KEY=
CRYPTO_PHONE_ENC_KEY=
CRYPTO_HASH_KEY=
KAKAO_REST_API_KEY=
# Solapi. Dev(발송하지 않고 로그만)는 Development 환경에서만 기동하므로 이 compose(Production)에서는 Solapi와 아래 세 값이 필요하다
SMS_PROVIDER=
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_SENDER=
# 외부에서 접근하는 주소(예: Tailscale Funnel의 https://<기기>.<tailnet>.ts.net). 끝에 / 없이 적는다
PUBLIC_BASE_URL=
