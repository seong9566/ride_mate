#!/bin/sh
# backend/ 변경이 스테이징된 커밋만 검사한다.
# 1) main 브랜치에서는 커밋을 막는다.
# 2) 솔루션을 경고=오류로 다시 빌드해 실패하면 커밋을 막는다.
# 설치(한 번): sh backend/scripts/install-hooks.sh
# 테스트: sh backend/githooks/tests/test-pre-commit.sh

if [ $# -gt 0 ]; then
  echo "사용법: git이 커밋 전에 부르는 훅이다. 인자는 없다. 손으로 확인하려면 sh backend/githooks/tests/test-pre-commit.sh 를 실행한다." >&2
  exit 64
fi

# 발동 기록: 통과·차단을 "<시각>\t<훅>\t<allow|block>\t<경로>" 한 줄로 남긴다(하네스 검사 E7·L1).
# 로그 폴더가 없으면 남기지 않고, 로그 실패는 훅 결과를 바꾸지 않는다. 경로는 HARNESS_HOOK_LOG로 바꾼다.
log_result() {
  rc=$?
  log="${HARNESS_HOOK_LOG:-$HOME/.claude/harness-audit/hooks.log}"
  if [ "$rc" = 0 ]; then decision=allow; else decision=block; fi
  { [ -d "${log%/*}" ] && printf '%s\t%s\t%s\t%s\n' "$(date +%Y-%m-%dT%H:%M:%S%z)" repo-pre-commit "$decision" "$PWD" >> "$log"; } 2>/dev/null
  exit "$rc"
}
trap log_result EXIT

# 파일 이름을 grep으로 거르지 않는다. 한글 파일 이름은 따옴표로 감싸여 출력돼 '^backend/'에 걸리지 않는다.
if git diff --cached --quiet -- backend/; then
  exit 0
fi

branch="$(git symbolic-ref --short -q HEAD)"
if [ "$branch" = "main" ]; then
  echo "[pre-commit] main 브랜치에는 backend/ 변경을 커밋하지 않는다. 브랜치를 만든 뒤 커밋한다(backend/AGENTS.md §작업 흐름)." >&2
  exit 1
fi

if ! command -v dotnet >/dev/null 2>&1; then
  echo "[pre-commit] dotnet을 찾을 수 없다. .NET 10 SDK를 설치한 뒤 커밋한다." >&2
  exit 1
fi

sln="$(git rev-parse --show-toplevel)/backend/RideMateService/RideMateService.sln"
echo "[pre-commit] backend 빌드 확인 중 (경고도 실패로 본다)…"
# 증분 빌드는 컴파일을 건너뛰어 경고를 놓치므로 --no-incremental로 다시 빌드한다.
if ! out="$(dotnet build "$sln" --no-incremental -warnaserror -nologo -v q 2>&1)"; then
  echo "$out" | grep -E "error|warning" >&2
  echo "[pre-commit] 빌드 실패. 고친 뒤 다시 커밋한다." >&2
  exit 1
fi
echo "[pre-commit] 빌드 통과"
exit 0
