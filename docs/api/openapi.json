{
  "openapi": "3.0.4",
  "info": {
    "title": "RideMate API",
    "version": "v1"
  },
  "paths": {
    "/api/v1/Auth/M/Token": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "토큰 발급",
        "requestBody": {
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "properties": {
                  "grant_type": {
                    "type": "string"
                  },
                  "refresh_token": {
                    "type": "string"
                  }
                }
              },
              "encoding": {
                "grant_type": {
                  "style": "form"
                },
                "refresh_token": {
                  "style": "form"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RideMateService_Comm_Dto_v1_Auth_Response_TokenAuthSuccessDto"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RideMateService_Comm_Dto_v1_Auth_Response_TokenAuthErrorDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/Auth/M/sign/DeleteLoginSession": {
      "delete": {
        "tags": [
          "Auth"
        ],
        "summary": "차량 로그아웃",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RideMateService_Comm_ResponseModel_System_Boolean"
                }
              }
            }
          }
        },
        "security": [
          {
            "Bearer": [ ]
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "RideMateService_Comm_Dto_v1_Auth_Response_TokenAuthErrorDto": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "nullable": true
          },
          "error_description": {
            "type": "string",
            "nullable": true
          },
          "remaining_attempts": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "retry_after": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "RideMateService_Comm_Dto_v1_Auth_Response_TokenAuthSuccessDto": {
        "type": "object",
        "properties": {
          "access_token": {
            "type": "string",
            "nullable": true
          },
          "token_type": {
            "type": "string",
            "nullable": true
          },
          "expires_in": {
            "type": "integer",
            "format": "int32"
          },
          "refresh_token": {
            "type": "string",
            "nullable": true
          },
          "session_id": {
            "type": "integer",
            "format": "int32"
          },
          "setup_required": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "RideMateService_Comm_ResponseModel_System_Boolean": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "nullable": true
          },
          "data": {
            "type": "boolean"
          },
          "code": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          }
        },
        "additionalProperties": false
      }
    },
    "securitySchemes": {
      "Bearer": {
        "type": "http",
        "description": "access 토큰만 입력한다. 'Bearer ' 접두는 Swagger가 붙인다.\n        예: eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "tags": [
    {
      "name": "Auth"
    }
  ]
}